{
  "name": "personalagent-inline-editor-build",
  "private": true,
  "version": "0.1.0",
  "description": "Build pipeline: bundle CodeMirror 6 + live-preview markdown plugin into a single IIFE consumed by inline-editor.html",
  "type": "module",
  "scripts": {
    "build": "esbuild bundle.mjs --bundle --format=iife --global-name=CM6 --outfile=../../PersonalAgent/Resources/InlineEditor/cm6.bundle.js --minify --target=safari16 --legal-comments=none",
    "build:dev": "esbuild bundle.mjs --bundle --format=iife --global-name=CM6 --outfile=../../PersonalAgent/Resources/InlineEditor/cm6.bundle.js --sourcemap --target=safari16"
  },
  "dependencies": {
    "@codemirror/commands": "^6.6.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.10.3",
    "@codemirror/search": "^6.5.6",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.34.1",
    "@lezer/common": "^1.2.1",
    "@lezer/markdown": "^1.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  }
}
